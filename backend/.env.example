# ============================================
# Configuracion del backend - Libreria MERN
# ============================================

# Base de datos MongoDB Atlas
# Formato: mongodb://user:pass@host1:port,host2:port,host3:port/db?options
MONGO_URI=mongodb://usuario:password@host1:27017,host2:27017,host3:27017/libreria_mern?authSource=admin&ssl=true&replicaSet=atlas-xxx-shard-0&appName=ClusterCulebra

# Puerto del servidor backend
PORT=5000

# Secreto para firmar los tokens JWT (OBLIGATORIO - generar uno seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=

# URL del frontend para CORS (sin barra final)
FRONTEND_URL=http://localhost:3000

# Entorno de ejecucion
NODE_ENV=development

# Contraseñas para seed (SOLO DESARROLLO - cambiar en producción)
SEED_ADMIN_PASSWORD=admin123
SEED_CLIENT_PASSWORD=cliente123