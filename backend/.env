# ============================================
# Configuracion del backend - Libreria MERN
# ============================================

# Base de datos MongoDB (por defecto usa la local)
MONGO_URI=mongodb://localhost:27017/libreria_mern

# Puerto del servidor backend
PORT=5000

# Secreto para firmar los tokens JWT (cambialo por uno propio)
JWT_SECRET=secreto_local_2026
